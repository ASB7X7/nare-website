# Server environment only; never upload real values to GitHub.
JENOVA_API_KEY=
JENOVA_AGENT_SLUG=
# Public HTTPS origin of this Node service, without a trailing path.
PUBLIC_BASE_URL=
# Exact browser origin, no /nare-website/ path.
ALLOWED_ORIGIN=https://asb7x7.github.io
PORT=3000
# Conservative pilot limits, per process; restarts reset counters.
MAX_REQUESTS_PER_DAY=20
MAX_REQUESTS_PER_HOUR_PER_IP=3
MAX_CONCURRENT=2
# Optional header set/overwritten by your trusted proxy (e.g. cf-connecting-ip).
# Leave empty unless the proxy is configured to prevent client spoofing.
TRUSTED_IP_HEADER=
